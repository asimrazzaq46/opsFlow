{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5434;Database=opsflow;Username=opsflow"
  },
  "Auth": {
    "Jwt": {
      "Issuer": "opsflow-api",
      "Audience": "opsflow-app",
      "AccessTokenMinutes": 15
    },
    "RefreshToken": {
      "LifetimeDays": 7,
      "MaxSessionDays": 30,
      "ReplayGraceSeconds": 10
    },
    "Password": {
      "Iterations": 210000
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "App": {
    "BaseUrl": "http://localhost:4300"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "EnableSsl": false,
    "FromAddress": "noreply@opsflow.local",
    "FromName": "OpsFlow",
    "TimeoutSeconds": 30
  },
  "Database": {
    "AutoApplyMigrationsOnStartup": false
  },
  "Realtime": {
    "HubPath": "/hubs/realtime",
    "RedisConnectionString": ""
  },
  "Background": {
    "ServerEnabled": false,
    "WorkerCount": 4,
    "SchedulePollingSeconds": 5,
    "OutboxDispatchCron": "*/10 * * * * *",
    "SlaScanCron": "0 * * * * *",
    "OutboxMaintenanceCron": "0 15 * * * *",
    "MaxDispatchBatches": 10
  },
  "Hangfire": {
    "ConnectionString": "",
    "SchemaName": "hangfire",
    "PrepareSchema": false,
    "DashboardEnabled": false,
    "DashboardAllowInProduction": false,
    "DashboardPath": "/hangfire"
  },
  "Outbox": {
    "BatchSize": 50,
    "LeaseSeconds": 120,
    "MaxAttempts": 8,
    "BaseDelaySeconds": 5,
    "MaxDelaySeconds": 900,
    "CompletedRetentionDays": 14,
    "EmailNotificationTypes": [ "TicketAssigned", "SlaWarning", "SlaBreached" ]
  },
  "Sla": {
    "WarningPercent": 75,
    "BatchSize": 200
  },
  "Cache": {
    "RedisConnectionString": "",
    "CategoriesTtlSeconds": 600,
    "SlaPoliciesTtlSeconds": 300
  },
  "Attachments": {
    "MaxBytes": 10485760
  },
  "RateLimiting": {
    "GlobalPermitLimit": 300,
    "SensitivePermitLimit": 10
  }
}
