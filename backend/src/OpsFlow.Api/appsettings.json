{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5434;Database=opsflow;Username=opsflow"
  },
  "Auth": {
    "Jwt": {
      "Issuer": "opsflow-api",
      "Audience": "opsflow-app",
      "AccessTokenMinutes": 15
    },
    "RefreshToken": {
      "LifetimeDays": 7,
      "MaxSessionDays": 30,
      "ReplayGraceSeconds": 10
    },
    "Password": {
      "Iterations": 210000
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "App": {
    "BaseUrl": "http://localhost:4300"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "EnableSsl": false,
    "FromAddress": "noreply@opsflow.local",
    "FromName": "OpsFlow"
  },
  "RateLimiting": {
    "GlobalPermitLimit": 300,
    "SensitivePermitLimit": 10
  }
}
