{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5434;Database=opsflow;Username=opsflow"
  },
  "App": {
    "BaseUrl": "http://localhost:4300"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "EnableSsl": false,
    "FromAddress": "noreply@opsflow.local",
    "FromName": "OpsFlow"
  },
  "RateLimiting": {
    "GlobalPermitLimit": 300,
    "SensitivePermitLimit": 10
  }
}
